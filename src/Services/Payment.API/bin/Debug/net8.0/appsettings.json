{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=YourCompanyBNPL_Payment;Trusted_Connection=true;MultipleActiveResultSets=true;TrustServerCertificate=true"
  },
  "Jwt": {
    "Key": "yourcompany-bnpl-super-secret-key-for-development-only-change-in-production",
    "Issuer": "https://api.yourcompany.com",
    "Audience": "https://api.yourcompany.com",
    "ExpiryMinutes": 60
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/payment-api-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ASPNETCORE_ENVIRONMENT": "Development",
  "PaymentSettings": {
    "DefaultCurrency": "NOK",
    "MaxRetryAttempts": 3,
    "PaymentExpiryHours": 24,
    "SettlementFrequency": "Daily",
    "LateFeeGracePeriodDays": 7,
    "MaxLateFeeAmount": 100.00,
    "BNPLSettings": {
      "MaxActivePlansPerCustomer": 5,
      "MinCreditScore": 600,
      "MaxPlanAmount": 100000.00,
      "InterestRates": {
        "PayIn3": 0.00,
        "PayIn4": 0.00,
        "PayIn6": 0.05,
        "PayIn12": 0.12,
        "PayIn24": 0.18
      },
      "DownPaymentPercentages": {
        "PayIn3": 0.33,
        "PayIn4": 0.25,
        "PayIn6": 0.20,
        "PayIn12": 0.15,
        "PayIn24": 0.10
      }
    }
  },
  "ExternalServices": {
    "RiskAssessmentApi": {
      "BaseUrl": "https://localhost:5002",
      "ApiKey": "risk-api-key",
      "TimeoutSeconds": 30
    },
    "NotificationApi": {
      "BaseUrl": "https://localhost:5003",
      "ApiKey": "notification-api-key",
      "TimeoutSeconds": 10
    },
    "SettlementApi": {
      "BaseUrl": "https://localhost:5004",
      "ApiKey": "settlement-api-key",
      "TimeoutSeconds": 60
    }
  },
  "HealthChecks": {
    "UI": {
      "HealthCheckDatabaseConnectionString": "Server=(localdb)\\mssqllocaldb;Database=YourCompanyBNPL_HealthChecks;Trusted_Connection=true;MultipleActiveResultSets=true;TrustServerCertificate=true"
    }
  },
  "Saml": {
    "Enabled": true,
    "ServiceProvider": {
      "EntityId": "https://api.yourcompany.com/saml",
      "ReturnUrl": "https://api.yourcompany.com/saml/acs",
      "CertificatePath": "certificates/sp-cert.pfx",
      "CertificatePassword": "your-certificate-password",
      "MetadataUrl": "https://api.yourcompany.com/saml/metadata"
    },
    "IdentityProviders": {
      "BankId": {
        "Enabled": true,
        "EntityId": "https://bankid.no/saml",
        "MetadataUrl": "https://bankid.no/saml/metadata",
        "CertificatePath": "certificates/bankid-cert.pfx"
      },
      "Feide": {
        "Enabled": true,
        "EntityId": "https://idp.feide.no",
        "MetadataUrl": "https://idp.feide.no/metadata"
      },
      "AzureAd": {
        "Enabled": true,
        "EntityId": "https://sts.windows.net/your-tenant-id/",
        "MetadataUrl": "https://login.microsoftonline.com/your-tenant-id/federationmetadata/2007-06/federationmetadata.xml",
        "TenantId": "your-tenant-id",
        "ClientId": "your-client-id"
      },
      "Generic": [
        {
          "EntityId": "https://your-idp.com/saml",
          "MetadataUrl": "https://your-idp.com/saml/metadata",
          "LoadMetadata": true,
          "AllowUnsolicitedAuthnResponse": false,
          "WantAuthnRequestSigned": true,
          "CertificatePath": "certificates/idp-cert.pfx",
          "CertificatePassword": "your-certificate-password"
        }
      ]
    }
  },
  "OpenIdConnect": {
    "Enabled": true,
    "Google": {
      "Enabled": true,
      "ClientId": "your-google-client-id",
      "ClientSecret": "your-google-client-secret"
    },
    "Microsoft": {
      "Enabled": true,
      "ClientId": "your-microsoft-client-id",
      "ClientSecret": "your-microsoft-client-secret",
      "TenantId": "your-tenant-id"
    },
    "Generic": {
      "Enabled": false,
      "Authority": "https://your-oidc-provider.com",
      "ClientId": "your-client-id",
      "ClientSecret": "your-client-secret",
      "CallbackPath": "/signin-oidc",
      "SignedOutCallbackPath": "/signout-oidc",
      "Scopes": ["openid", "profile", "email"],
      "ClaimMappings": [
        {
          "ClaimType": "picture",
          "JsonKey": "picture"
        },
        {
          "ClaimType": "locale",
          "JsonKey": "locale"
        }
      ],
      "ValidateIssuer": true,
      "ValidIssuer": "https://your-oidc-provider.com",
      "ValidateAudience": true,
      "ValidAudience": "your-client-id",
      "ValidateLifetime": true,
      "ClockSkewMinutes": 5
    }
  },
  "AzureAd": {
    "Enabled": true,
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "your-tenant-id",
    "ClientId": "your-client-id",
    "ClientSecret": "your-client-secret",
    "Domain": "yourcompany.onmicrosoft.com",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-oidc",
    "Scopes": [
      "https://graph.microsoft.com/User.Read",
      "https://graph.microsoft.com/Group.Read.All",
      "https://graph.microsoft.com/Directory.Read.All"
    ],
    "RequiredGroups": [
      "BNPL-Users",
      "BNPL-Admins"
    ],
    "Graph": {
      "BaseUrl": "https://graph.microsoft.com/v1.0",
      "Scopes": [
        "User.Read",
        "Group.Read.All",
        "Directory.Read.All"
      ]
    },
    "B2C": {
      "Enabled": false,
      "Domain": "yourcompany.b2clogin.com",
      "SignUpSignInPolicyId": "B2C_1_signupsignin",
      "ResetPasswordPolicyId": "B2C_1_resetpassword",
      "EditProfilePolicyId": "B2C_1_editprofile"
    }
  }
}