# YourCompany BNPL Platform - Environment Variables Template
# Copy this file to .env and update with your actual values
# NEVER commit .env file with real secrets to version control!

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_SA_PASSWORD=YourStrong@Passw0rd
DB_PAYMENT_NAME=YourCompanyBNPL_Payment
DB_RISK_NAME=YourCompanyBNPL_Risk
DB_SETTLEMENT_NAME=YourCompanyBNPL_Settlement
DB_NOTIFICATION_NAME=YourCompanyBNPL_Notification

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_PASSWORD=your-redis-password-change-me
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================================
# MONGODB CONFIGURATION
# ============================================================================
MONGODB_ROOT_USERNAME=admin
MONGODB_ROOT_PASSWORD=your-mongodb-password-change-me
MONGODB_DATABASE_NAME=YourCompanyBNPL

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
JWT_SECRET_KEY=yourcompany-bnpl-super-secret-key-for-production-change-this-to-at-least-256-bits
JWT_ISSUER=https://api.yourcompany.com
JWT_AUDIENCE=https://api.yourcompany.com
JWT_EXPIRY_MINUTES=60

# ============================================================================
# ASPNET CORE CONFIGURATION
# ============================================================================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80;https://+:443
ASPNETCORE_HTTPS_PORT=5001

# ============================================================================
# CERTIFICATE CONFIGURATION
# ============================================================================
CERTIFICATE_PASSWORD=your-certificate-password
CERTIFICATE_PATH=/https/aspnetapp.pfx

# ============================================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================================
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM_ADDRESS=noreply@yourcompany.com
EMAIL_FROM_NAME=YourCompany BNPL Platform

# ============================================================================
# SMS CONFIGURATION (TWILIO)
# ============================================================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number
TWILIO_MESSAGING_SERVICE_SID=your-messaging-service-sid

# ============================================================================
# PUSH NOTIFICATION (FIREBASE)
# ============================================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# ============================================================================
# AZURE CONFIGURATION (Optional)
# ============================================================================
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id

# ============================================================================
# APPLICATION INSIGHTS
# ============================================================================
APPINSIGHTS_INSTRUMENTATIONKEY=your-app-insights-key
APPINSIGHTS_CONNECTION_STRING=your-app-insights-connection-string

# ============================================================================
# PAYMENT GATEWAYS
# ============================================================================
# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# Adyen
ADYEN_API_KEY=your-adyen-api-key
ADYEN_MERCHANT_ACCOUNT=your-adyen-merchant-account
ADYEN_ENVIRONMENT=test

# ============================================================================
# NORWEGIAN CREDIT BUREAUS
# ============================================================================
# Experian Norway
EXPERIAN_API_KEY=your-experian-api-key
EXPERIAN_BASE_URL=https://api.experian.no/v1

# Bisnode
BISNODE_API_KEY=your-bisnode-api-key
BISNODE_USERNAME=your-bisnode-username
BISNODE_BASE_URL=https://api.bisnode.no/v2

# Lindorff
LINDORFF_API_KEY=your-lindorff-api-key
LINDORFF_CLIENT_ID=your-lindorff-client-id
LINDORFF_BASE_URL=https://api.lindorff.no/v1

# ============================================================================
# NORWEGIAN REGISTRIES
# ============================================================================
FOLKEREGISTER_API_KEY=your-folkeregister-api-key
FOLKEREGISTER_BASE_URL=https://api.folkeregisteret.no/v1

KONKURSREGISTER_API_KEY=your-konkursregister-api-key
KONKURSREGISTER_BASE_URL=https://api.konkursregisteret.no/v1

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202,https://admin.yourcompany.com,https://consumer.yourcompany.com,https://merchant.yourcompany.com

# ============================================================================
# GRAFANA CONFIGURATION
# ============================================================================
GRAFANA_ADMIN_PASSWORD=admin-change-me

# ============================================================================
# ELASTICSEARCH CONFIGURATION
# ============================================================================
ELASTICSEARCH_PASSWORD=elastic-password-change-me

# ============================================================================
# SERVICE BUS CONFIGURATION
# ============================================================================
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://yourcompany-bnpl.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your-key

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_WINDOW_MINUTES=1

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=Information
LOG_RETENTION_DAYS=30

# ============================================================================
# HEALTH CHECKS
# ============================================================================
HEALTHCHECK_ENABLED=true
HEALTHCHECK_INTERVAL_SECONDS=30

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/backups

# ============================================================================
# NOTES
# ============================================================================
# 1. Generate strong passwords using: openssl rand -base64 32
# 2. For JWT secrets, use at least 256 bits: openssl rand -base64 32
# 3. Never commit this file with real values to version control
# 4. Use Azure Key Vault or similar secret management in production
# 5. Rotate secrets regularly (recommended every 90 days)
# 6. Use different secrets for each environment (dev, staging, production)
