{
  "name": "yourcompany-bnpl-platform",
  "version": "1.0.0",
  "description": "YourCompany BNPL Checkout Debt Management Platform - Complete fintech solution for Buy Now Pay Later services in Norway",
  "main": "gulpfile.js",
  "scripts": {
    "start": "gulp dev",
    "build": "gulp build",
    "build:dev": "gulp build:dev",
    "build:prod": "gulp build:prod",
    "build:production": "gulp build:production",
    "serve": "gulp serve",
    "watch": "gulp watch",
    "test": "gulp test",
    "lint": "gulp lint:js",
    "clean": "gulp clean",
    "deploy": "gulp deploy",
    "docker:build": "gulp docker:build",
    "docker:run": "gulp docker:run",
    "docker:stop": "gulp docker:stop",
    "health:check": "gulp health:check",
    "install:all": "npm run install:services && npm run install:web",
    "install:services": "cd src/Services && find . -name package.json -execdir npm install \\;",
    "install:web": "cd src/Web && find . -name package.json -execdir npm install \\;",
    "build:services": "cd src/Services && find . -name *.csproj -execdir dotnet build \\;",
    "build:web": "cd src/Web && find . -name package.json -execdir npm run build \\;",
    "test:services": "cd src/Services && find . -name *.csproj -execdir dotnet test \\;",
    "test:web": "cd src/Web && find . -name package.json -execdir npm test \\;",
    "start:services": "docker-compose up -d",
    "stop:services": "docker-compose down",
    "logs:services": "docker-compose logs -f",
    "restart:services": "npm run stop:services && npm run start:services"
  },
  "keywords": [
    "bnpl",
    "buy-now-pay-later",
    "fintech",
    "payments",
    "norway",
    "yourcompany",
    "debt-management",
    "checkout",
    "microservices",
    "dotnet",
    "nodejs",
    "vue",
    "knockout",
    "real-time",
    "notifications",
    "risk-assessment",
    "settlement",
    "saml",
    "openid-connect",
    "azure-ad"
  ],
  "author": "YourCompany BNPL Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourcompany/bnpl-platform.git"
  },
  "bugs": {
    "url": "https://github.com/yourcompany/bnpl-platform/issues"
  },
  "homepage": "https://github.com/yourcompany/bnpl-platform#readme",
  "dependencies": {
    "gulp": "^4.0.2",
    "gulp-concat": "^2.6.1",
    "gulp-uglify": "^3.0.2",
    "gulp-sass": "^5.1.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-rename": "^2.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-watch": "^5.0.1",
    "gulp-browser-sync": "^2.29.0",
    "gulp-eslint": "^6.0.0",
    "gulp-jasmine": "^4.0.0",
    "gulp-karma": "^0.0.5",
    "karma": "^6.4.0",
    "karma-jasmine": "^5.1.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-firefox-launcher": "^2.1.2",
    "karma-phantomjs-launcher": "^1.0.4",
    "eslint": "^8.47.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-standard": "^5.0.0",
    "sass": "^1.64.0",
    "browser-sync": "^2.29.0",
    "del": "^6.1.1",
    "run-sequence": "^2.2.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.2",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.4",
    "eslint-plugin-jest": "^27.4.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "ie >= 11"
  ]
}
